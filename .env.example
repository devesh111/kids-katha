# Database Configuration
# MySQL database connection string
DATABASE_URL="mysql://user:password@localhost:3306/storytime_app"

# JWT Secrets
# Use long, random strings in production
JWT_ACCESS_SECRET="your-long-random-access-secret-change-in-production"
JWT_REFRESH_SECRET="your-long-random-refresh-secret-change-in-production"

# Media Configuration
# Base URL for media files (stories, images)
MEDIA_BASE_URL="https://media.example.com/"

# Free Stories Configuration
# Comma-separated list of story IDs that are free to play
FREE_STORY_IDS="19,22,24,177"

# Playback Storage
# Options: redis, memory, localStorage
PLAYBACK_STORE="memory"

# Redis Configuration (if using Redis for playback storage)
REDIS_URL="redis://localhost:6379"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Kids Katha"

# Node Environment
NODE_ENV="development"
